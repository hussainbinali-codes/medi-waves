ir \/ Oxygen blender.<\/li><\/ul>\t\t\t\t\t\t\t<\/div>\r\n\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-fd82275 flex-horizontal-align-default flex-horizontal-align-tablet-default flex-horizontal-align-mobile-default flex-vertical-align-default flex-vertical-align-tablet-default flex-vertical-align-mobile-default elementor-widget elementor-widget-thegem-styledbutton\" data-id=\"fd82275\" data-element_type=\"widget\" data-settings=\"{&quot;thegem_button_skin&quot;:&quot;outline&quot;,&quot;add_icon&quot;:&quot;yes&quot;}\" data-widget_type=\"thegem-styledbutton.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<div class=\"gem-button-container gem-widget-button\">\n\n\t\t<a class=\"gem-button gem-button-size-medium gem-button-text-weight-bold gem-button-style-outline gem-button-border-3\" href=\"http:\/\/hardikmeditech.com\/medi-waves\/wp-content\/uploads\/2023\/05\/T-Piece_Cat.pdf\">\n\t\t<span class=\"gem-inner-wrapper-btn\">\n\t\t\t\t\t\t\t<span class=\"gem-button-icon\">\n\t\t\t\t\t<i aria-hidden=\"true\" class=\"fas fa-file-pdf\"><\/i>\t\t\t\t<\/span>\n\t\t\t\t\t\t<span class=\"gem-text-button\">\n\t\t\t\tDownload\t\t\t<\/span>\n\t\t<\/span>\n\t<\/a>\n\n\t\n<\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div><\/div>\r\n\t\t<\/section>\r\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Infant T-Piece Resuscitator Description It is mainly used on delivery room, baby wards, NICU that the baby&#8217;s maximum weight up&#8230;<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":991,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"page-fullwidth.php","meta":{"footnotes":""},"class_list":["post-3435","page","type-page","status-publish"],"_links":{"self":[{"href":"https:\/\/www.medi-waves.com\/wp-json\/wp\/v2\/pages\/3435","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www